# ------------------------------------------------------------------
# UTMFY Tracker — variáveis de ambiente (copie para .env.local)
# NUNCA commite valores reais. Tudo abaixo é lido só no servidor,
# exceto NEXT_PUBLIC_* (URL e chave pública do Supabase).
# ------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # chave publishable/anon
SUPABASE_SERVICE_ROLE_KEY=               # só servidor (webhook, jobs)

# URL pública do app (usada no script do tracker, webhook e OAuth)
APP_URL=https://seu-app.vercel.app
# Segredo dos crons (Authorization: Bearer ...). Gere: openssl rand -hex 24
CRON_SECRET=

# Cakto — API (Integrações → Cakto API → Criar chave, escopos read + orders + products + offers)
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# Secret(s) dos webhooks Cakto, separados por vírgula (um por webhook cadastrado)
CAKTO_WEBHOOK_SECRETS=
# Aceitar validação pelo campo "secret" do corpo quando faltar o header de assinatura
CAKTO_ALLOW_BODY_SECRET=true
# Workspace que recebe webhooks sem ?ws= na URL (opcional)
CAKTO_WEBHOOK_WORKSPACE_SLUG=

# Meta — somente leitura (token de System User com ads_read)
META_ACCESS_TOKEN=
# Opcional: login com Facebook (OAuth) em vez de token fixo
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_LOOKBACK_DAYS=3

# Conversions API (fase posterior) — deixe false até validar a atribuição
CAPI_ENABLED=false
META_CAPI_TOKEN=
